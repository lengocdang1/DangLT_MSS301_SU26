  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login - Customer (an@gmail.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var r = pm.response.json();",
                  "pm.test('Has accessToken', () => pm.expect(r.accessToken).to.be.a('string'));",
                  "pm.test('Role is CUSTOMER', () => pm.expect(r.role).to.eql('CUSTOMER'));",
                  "pm.environment.set('customerToken', r.accessToken);",
                  "pm.environment.set('customerId', r.userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"an@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {"raw": "{{gateway}}/api/auth/login", "host": ["{{gateway}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Login - Admin",
